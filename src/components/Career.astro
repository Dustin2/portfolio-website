---
import type { Content } from '../i18n';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="experience" class="section wrap">
  <p class="kicker reveal">{t.career.kicker}</p>
  <div class="timeline reveal">
    {
      t.career.jobs.map((job) => (
        <div class="job">
          <div class="when">{job.when}</div>
          <h3>{job.role}</h3>
          <p class="where">{job.where}</p>
          <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))
    }
  </div>
  <div class="cells edu reveal">
    {
      t.career.education.map((e) => (
        <div class="cell">
          <h3>{e.title}</h3>
          <p>{e.detail}</p>
        </div>
      ))
    }
  </div>
</section>
