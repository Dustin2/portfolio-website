---
import { stack } from '../data';
import type { Content } from '../i18n';
import Heading from './Heading.astro';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="stack">
  <div class="wrap reveal">
    <Heading text={t.stack.title} />
    <div class="marquee"><div class="stack">{stack.map((s) => <span>{s}</span>)}</div></div>
  </div>
</section>
