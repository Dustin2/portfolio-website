---
import { expertiseTags } from '../data';
import type { Content } from '../i18n';
import type { ExpertiseId } from '../i18n/types';
import Heading from './Heading.astro';
import Tags from './Tags.astro';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const ids: ExpertiseId[] = ['frontend', 'backend', 'mobile'];
---

<section id="what">
  <div class="wrap reveal">
    <Heading text={t.what.title} />
    <div class="grid2">
      {
        ids.map((id) => (
          <div class="box">
            <h3>{t.what.areas[id].title}</h3>
            <p>{t.what.areas[id].text}</p>
            <Tags tags={expertiseTags[id]} />
          </div>
        ))
      }
    </div>
  </div>
</section>
