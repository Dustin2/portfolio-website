---
import { email, githubUrl } from '../data';
import type { Content } from '../i18n';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="contact" class="section wrap contact">
  <p class="kicker reveal">{t.contact.kicker}</p>
  <h2 class="reveal">{t.contact.title}</h2>
  <div class="reveal">
    <button class="mail" type="button" data-email={email}>{email}</button>
    <p class="hint">{t.contact.hint}</p>
    <div class="social">
      <a href={`mailto:${email}`}>{t.contact.sendEmail}</a>
      <a href={githubUrl}>GitHub</a>
    </div>
  </div>
</section>
